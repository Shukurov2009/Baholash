# Nusxa oling: cp .env.example .env
DATABASE_URL=sqlite:///./baholash.db
# PostgreSQL uchun: postgresql+psycopg2://user:parol@localhost:5432/baholash
SECRET_KEY=bu-yerga-uzun-tasodifiy-satr-yozing
TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true

# Litsenziya tekshiruvi hozircha o'chirilgan
LICENSE_REQUIRED=false
# Super admin (ixtiyoriy). ADMIN_PASSWORD bo'sh bo'lsa, birinchi ishga tushishda tasodifiy parol yaratilib terminalga chiqadi.
ADMIN_EMAIL=admin@baholash.uz
ADMIN_PASSWORD=
